// ============================================
// Proyecto:  BikeSafe - Candado inteligente portatil
// Archivo:   interfaz/firestore.rules
// Objetivo:  Reglas de seguridad de Cloud Firestore
// Equipo:    Oscar Sandoval Cabrera (23240457),
//            Diego Josue Talamantes Santiago (23240355)
// Materia:   Sistemas Programables - ISC TecNM Leon
// Semestre:  ago-dic-2026
// ============================================
//
// - Solo los integrantes del equipo pueden LEER, iniciando sesion con
//   Google en el dashboard. Se identifican por su UID de Firebase
//   (Authentication > Usuarios). Asi las fotos de personas que analiza
//   la IA NO son publicas.
// - Nadie escribe desde el navegador. Solo el servidor Python escribe,
//   con su llave de cuenta de servicio (firebase-admin se salta estas
//   reglas).
// Se pegan en: consola de Firebase > Firestore Database > Reglas.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esDelEquipo() {
      return request.auth != null && request.auth.uid in [
        "Mb2PTewTB8N3L1G7qAefPsLuAzv2",   // Oscar Sandoval Cabrera
        "UID_JOSUE"    // Diego Josue Talamantes Santiago (pendiente)
      ];
    }
    match /proyectos/bikesafe/{document=**} {
      allow read: if esDelEquipo();
      allow write: if false;
    }
  }
}
